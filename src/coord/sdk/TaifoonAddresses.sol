pragma solidity ^0.8.20;

import {Deployments} from "./Deployments.sol";

/// @title TaifoonAddresses — where each coord module has LANDED, per chain
/// @notice GENERATED by deploy/gen-sdk-deployments.mjs from the address registry's live rows (packages/addresses); do not edit.
///         The economy modules share one address on every EVM (Deployments.sol) but are deployed chain by chain: call
///         `requireLive(block.chainid, Module.X)` before using one so a contract fails clearly where a module is absent.
///         The per-chain contracts (assurance hook, Jev) have their own address per chain.
library TaifoonAddresses {
    enum Module { Anchor, Lambda, Verifier, TsulDonut, PaymentChannel, Workflow }

    error NotLive(uint256 chainId, string what);

    /// @notice Whether module `m` is deployed on `chainId`.
    function isLive(uint256 chainId, Module m) internal pure returns (bool) {
        if (chainId == 100) return m == Module.TsulDonut;
        if (chainId == 8453) return m == Module.Anchor || m == Module.Lambda || m == Module.Verifier || m == Module.TsulDonut || m == Module.PaymentChannel || m == Module.Workflow;
        if (chainId == 36927) return m == Module.Anchor || m == Module.Lambda || m == Module.Verifier || m == Module.TsulDonut || m == Module.PaymentChannel || m == Module.Workflow;
        if (chainId == 3692781) return m == Module.Anchor || m == Module.Lambda || m == Module.Verifier || m == Module.TsulDonut || m == Module.PaymentChannel || m == Module.Workflow;
        return false;
    }

    /// @notice Revert `NotLive` unless module `m` is deployed on `chainId`; returns its address.
    function requireLive(uint256 chainId, Module m) internal pure returns (address a) {
        if (!isLive(chainId, m)) revert NotLive(chainId, _name(m));
        return addressOf(m);
    }

    /// @notice The module's address (the same on every EVM chain; whether it is deployed there is `isLive`).
    function addressOf(Module m) internal pure returns (address) {
        if (m == Module.Anchor) return Deployments.ANCHOR;
        if (m == Module.Lambda) return Deployments.LAMBDA;
        if (m == Module.Verifier) return Deployments.VERIFIER;
        if (m == Module.TsulDonut) return Deployments.TSUL_DONUT;
        if (m == Module.PaymentChannel) return Deployments.PAYMENT_CHANNEL;
        return Deployments.WORKFLOW;
    }

    /// @notice the assurance hook (V4 proxy, owned by the council Safe) on `chainId`; reverts `NotLive` where it is not deployed.
    function assuranceHook(uint256 chainId) internal pure returns (address) {
        if (chainId == 143) return 0xBf4283b791d5a5541F01BC93ef5DD9B9dC8f334c;
        if (chainId == 4663) return 0xBf4283b791d5a5541F01BC93ef5DD9B9dC8f334c;
        if (chainId == 5042) return 0x1c7c44e1A43d661675A7f1E583d351adfD48F872;
        if (chainId == 8453) return 0x93122A47d1824afFA3bAa5751aacf4919F67eb25;
        if (chainId == 42161) return 0x6423B2250d41Cf0F786F5e4F8b962b03c8483A0B;
        revert NotLive(chainId, "assuranceHook");
    }

    /// @notice Jev's evaluator seat (JudgeAdapterV5) on `chainId`; reverts `NotLive` where it is not deployed.
    function judgeAdapterV5(uint256 chainId) internal pure returns (address) {
        if (chainId == 8453) return 0x5242dE388a846d16641744dEB095eD63990E7be8;
        revert NotLive(chainId, "judgeAdapterV5");
    }

    /// @notice the Jev decision log on `chainId`; reverts `NotLive` where it is not deployed.
    function jevDecisionLog(uint256 chainId) internal pure returns (address) {
        if (chainId == 143) return 0x1aC6266b9926cB3E206D5dc0c9d1B7c873aa150a;
        if (chainId == 5042) return 0x863db7dAc69CC614a98822082cbe884F1f3b55cA;
        if (chainId == 8453) return 0x209490d6A0FFC5368A42b0c2208BDCda853f6a92;
        if (chainId == 42161) return 0x1aC6266b9926cB3E206D5dc0c9d1B7c873aa150a;
        revert NotLive(chainId, "jevDecisionLog");
    }

    /// @notice The Jev recorder: the key whose records in the decision log are Jev's (the same KMS address on every chain).
    address internal constant JEV_RECORDER = 0xe9F0E71e7Fc66864126C0aE5588a7858b25dE51D;

    function _name(Module m) private pure returns (string memory) {
        if (m == Module.Anchor) return "Anchor";
        if (m == Module.Lambda) return "Lambda";
        if (m == Module.Verifier) return "Verifier";
        if (m == Module.TsulDonut) return "TsulDonut";
        if (m == Module.PaymentChannel) return "PaymentChannel";
        if (m == Module.Workflow) return "Workflow";
        return "";
    }
}
